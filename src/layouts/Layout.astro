---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource-variable/reddit-sans/index.css";
import "@fontsource-variable/reddit-sans/wght-italic.css";
import "../styles/global.css";
import redditSansLatin from "@fontsource-variable/reddit-sans/files/reddit-sans-latin-wght-normal.woff2?url";
import redditSansLatinExtended from "@fontsource-variable/reddit-sans/files/reddit-sans-latin-ext-wght-normal.woff2?url";

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site,
).toString();

const { title } = Astro.props;

const { pathname } = Astro.url;

const makeTitle = title
  ? title + " | " + "tim.js"
  : "tim.js - Timisoara JavaScript Community";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {pathname === "/" &&
      [redditSansLatin, redditSansLatinExtended].map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      ))}
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description="tim.js - Timisoara JavaScript Community - a monthly meetup and a registered NGO"
      canonical={canonicalURL}
      twitter={{
        creator: "@timjscommunity",
        site: "@timjscommunity",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `tim.js - Timisoara JavaScript Community`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Photo from our 10 years anniversary meetup",
        },
      }}
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
